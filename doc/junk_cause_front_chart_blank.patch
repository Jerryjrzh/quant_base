+#### 解决方案
+**文件**: `frontend/js/app.js`
+**函数**: `loadChart()`
+
+```javascript
+function loadChart() {
+    const stockCode = stockSelect.value;
+    const strategy = strategySelect.value;
+    
+    // --- 新增的保护性代码 ---
+    // 如果没有选择股票或没有选择策略，则不执行任何操作
+    if (!stockCode || !strategy) {
+        // 可以选择清空图表或保持原样
+        // myChart.clear(); 
+        return;
+    }
+    // --- 保护性代码结束 ---
+
+    myChart.showLoading();
+    // ... 后续逻辑不变
+}
+```
