+                        'best_exit_day': best_exit_day,
+                        'worst_drawdown_day': worst_drawdown_day,
+                        'risk_adjusted_return': round(risk_adjusted_return, 4),
+                        'signal_quality': signal_quality,
+                        'validation_timestamp': datetime.now().isoformat()
+                    })
+                    
+                    # 收集统计数据
+                    validation_stats['total_validated'] += 1
+                    if final_return > 0.02:
+                        validation_stats['success_count'] += 1
+                    
+                    max_profits.append(max_profit)
+                    max_drawdowns.append(max_drawdown)
+                    final_returns.append(final_return)
+                    
+                    # 按策略统计
+                    strategy_name = result.strategy_name
