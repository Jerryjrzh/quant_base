+                    max_drawdown = 0.0
+                    final_return = 0.0
+                    best_exit_day = 0
+                    worst_drawdown_day = 0
+                    
+                    for j, (date, row) in enumerate(future_data.iterrows()):
+                        current_return = (row['close'] - entry_price) / entry_price
+                        
+                        if current_return > max_profit:
+                            max_profit = current_return
+                            best_exit_day = j + 1
+                        
+                        if current_return < max_drawdown:
+                            max_drawdown = current_return
+                            worst_drawdown_day = j + 1
+                        
+                        if j == len(future_data) - 1:  # 最后一天
+                            final_return = current_return
+                    
+                    # 计算风险调整收益
+                    risk_adjusted_return = final_return / abs(max_drawdown) if max_drawdown < 0 else final_return
+                    
+                    # 判断信号质量
+                    signal_quality = 'EXCELLENT' if max_profit > 0.1 and max_drawdown > -0.05 else \
+                                   'GOOD' if max_profit > 0.05 and max_drawdown > -0.1 else \
+                                   'FAIR' if final_return > 0 else 'POOR'
+                    
