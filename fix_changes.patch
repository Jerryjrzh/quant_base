+    def _momentum_pre_filter(self, stock_code: str) -> bool:
+        """
+        动量预过滤器 - 快速筛选有潜力的强势股
+        
+        Args:
+            stock_code: 股票代码
+            
+        Returns:
+            bool: 是否通过预过滤
+        """
+        try:
+            # 获取基础日线数据
+            daily_df = get_full_data_with_indicators(stock_code)
+            if daily_df is None or len(daily_df) < 30:
+                return False
+            
+            recent_data = daily_df.tail(20)
+            current_price = recent_data['close'].iloc[-1]
+            
+            # 检查20日内涨幅是否>12%
+            low_20d = recent_data['low'].min()
+            rise_pct = (current_price - low_20d) / low_20d * 100
+            
+            if rise_pct < 12:  # 涨幅不足12%
+                return False
+            
+            # 检查成交量是否放大
+            if 'volume' in recent_data.columns:
+                recent_vol = recent_data['volume'].tail(5).mean()
+                base_vol = recent_data['volume'].head(15).mean()
+                vol_ratio = recent_vol / base_vol if base_vol > 0 else 1.0
+                
+                if vol_ratio < 1.2:  # 成交量未放大1.2倍
+                    return False
+            
+            # 检查是否为资源/科技等热门板块（简化版）
+            if any(tag in stock_code for tag in ['002021', '002796', '688']):  # 示例：资源股、科技股
+                return True
+            
+            return True  # 通过基础动量检查
+            
+        except Exception as e:
+            logger.error(f"动量预过滤失败 {stock_code}: {e}")
+            return True  # 出错时不过滤，保持原有逻辑
+
 # 全局实例
